{
  "name": "print-proofer",
  "version": "1.0.0",
  "description": "Snap a photo or screenshot of a print proof and get spelling, grammar and consistency checks.",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite --host",
    "build": "npm run assets && tsc && vite build",
    "preview": "vite preview --host",
    "android:sync": "npm run build && node scripts/strip-web-ocr.mjs && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHREGGIE/print-proofer.git"
  },
  "bugs": {
    "url": "https://github.com/CHREGGIE/print-proofer/issues"
  },
  "homepage": "https://github.com/CHREGGIE/print-proofer#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@fontsource/dm-sans": "^5.2.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/nspell": "^2.1.6",
    "typescript": "^5.8.3",
    "vite": "^6.4.5"
  },
  "private": true,
  "type": "module"
}
